<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme. The actual colours live in CSS; this only paints the
         system bars so the WebView blends with the OS. -->
    <style name="Theme.Pulse" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/pulse_bg</item>
        <item name="android:navigationBarColor">@color/pulse_bg</item>
        <item name="android:windowBackground">@color/pulse_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/pulse_brand_400</item>
    </style>

    <!-- Launcher theme (AndroidX SplashScreen): the system splash shows the Pulse mark on the
         brand background, MainActivity holds it until the web UI has painted, fades it out in
         200 ms, and the library then swaps in Theme.Pulse. Works the same on Android 7-15. -->
    <style name="Theme.Pulse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pulse_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_pulse_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Pulse</item>
    </style>

</resources>
